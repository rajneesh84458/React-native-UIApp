// Recursive  Component\
const TreeNode = (\{\
  item, depth = 0, selected, setSelected\
\}) => \{\
  const [open, setOpen] = useState(false);\
\
  const hasChild = item?.child?.length;\
  console.log('hasChild ----', hasChild);\
\
  const handlePress = () => \{\
    setSelected(item.name);\
    if (hasChild) \{\
      setOpen((prev) => !prev);\
    \}\
  \};\
  return (\
    <View>\
      <TouchableOpacity\
        onPress=\{handlePress\}\
        activeOpacity=\{0.6\}\
        style=\{[styles.row, \{ paddingLeft: depth * 14 \}, selected === item.name && styles.selectedRow]\}\
      >\
        <Text style=\{styles.icon\}>\
          \{hasChild ? (open ? '\uc0\u9660 ' : '\u9654 ') : '\'95'\}\
        </Text>\
\
        <Text style=\{styles.text\}>\{item.name\}</Text>\
      </TouchableOpacity>\
\
      \{open && hasChild\
        && item.child.map((child, i) => (\
          <TreeNode\
            key=\{`$\{item.name\}-$\{i\}`\}\
            item=\{child\}\
            depth=\{depth + 1\}\
            selected=\{selected\}\
            setSelected=\{setSelected\}\
          />\
        ))\}\
    </View>\
  );\
\};\
\
// Tree Wrapper\
const TreeView = (\{ data = [] \}) => \{\
  const [selected, setSelected] = useState(null);\
\
  return (\
    <View>\
      \{data.map((item, index) => (\
        <TreeNode\
          key=\{`$\{item.name\}-$\{index\}`\}\
          item=\{item\}\
          selected=\{selected\}\
          setSelected=\{setSelected\}\
        />\
      ))\}\
    </View>\
  );\
\};\
\
// Mock Data\
