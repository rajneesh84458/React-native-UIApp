];\
\
// Main Screen\
const App = () => (\
  <SafeAreaView style=\{styles.container\}>\
    <Text style=\{styles.header\}>Screening - Assignment</Text>\
    <View style=\{styles.top\}>\
      <TreeView data=\{treeData\} />\
